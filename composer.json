{
	"name": "apple-sync/apple_sync",
	"description": "One-way sync of iCloud Photos, Drive, Contacts, Calendars and Reminders into Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.3",
		"ext-gmp": "*"
	},
	"require-dev": {
		"doctrine/dbal": "3.10.4",
		"guzzlehttp/guzzle": "^7.9",
		"nextcloud/ocp": "dev-stable35",
		"phpunit/phpunit": "^11.5",
		"sabre/vobject": "4.5.6"
	},
	"autoload": {
		"psr-4": {
			"OCA\\AppleSync\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\AppleSync\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		}
	}
}
